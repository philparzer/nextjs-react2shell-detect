{
  "name": "nextjs-react2shell-detect",
  "displayName": "Next.js React2shell detector",
  "version": "0.0.1",
  "description": "detects vulnerable Next.js versions that are susceptible to React2shell attacks locally in the browser",
  "author": "adler.studio",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "prettier": "3.2.4",
    "typescript": "5.3.3"
  },
  "manifest": {
    "permissions": ["scripting"],
    "host_permissions": [
      "https://*/*",
      "http://*/*"
    ],
    "icons": {
      "16": "../assets/icon.png",
      "32": "../assets/icon.png",
      "48": "../assets/icon.png",
      "128": "../assets/icon.png"
    },
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "16": "../assets/icon.png",
        "32": "../assets/icon.png"
      }
    }
  }
}
